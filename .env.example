# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, full DB access, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# App
# Public base URL of this deployment, used for webhook callback URLs, email links, etc.
NEXT_PUBLIC_APP_URL=

# Anthropic — used for onboarding transcript parsing and call summarization/alerts
ANTHROPIC_API_KEY=

# Retell — voice call provider
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_VOICE_ID=

# Stripe — billing
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe CLI or Dashboard webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESENCIAL=
STRIPE_PRICE_COMPLETO=
STRIPE_PRICE_FAMILIAR=

# Resend — transactional email (invites, alert notifications)
RESEND_API_KEY=

# Cloudflare Turnstile — bot protection on auth forms. Optional: leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Internal service-to-service auth
# Shared secret the call webhook uses to call the summarize endpoint.
INTERNAL_API_SECRET=
# Bearer token required to trigger the daily call cron endpoint.
CRON_SECRET=

# Upstash QStash — schedules each day's calls (including the Completo plan's
# spaced-apart second call) as delayed callbacks, since Vercel Hobby's cron
# can only fire this app's own trigger-calls route once a day. Dashboard:
# https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
